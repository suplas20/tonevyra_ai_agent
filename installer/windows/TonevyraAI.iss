; Tonevyra AI - Windows all-in-one installer (Inno Setup 6)
;
; This script installs the frozen application, the bundled local model, the
; Lightroom plugin and app resources natively through Inno Setup [Files], then
; runs a single provisioning helper that acquires + installs PostgreSQL,
; bootstraps the Tonevyra database and runs the post-install doctor. Inno owns
; file placement, shortcuts and the uninstaller; the app CLI owns DB schema,
; verification and doctor gates (no reimplementation in PowerShell).
;
; Machine-specific source paths are supplied by the build script via ISCC /D:
;   /DAppSource=<frozen PyInstaller onedir>
;   /DModelSource=<local Qwen3-VL-4B model root>
;   /DPluginSource=<TonevyraAI.lrplugin dir>
;   /DResourcesSource=<resources dir>
;   /DInstallerSrc=<installer/windows dir with provisioning + readme + env>
;   /DStageDir=<generated stage dir with relative model_manifest.json>
;   /DOutputDir=<output dir> /DMyAppVersion=<version>

#define MyAppName "Tonevyra AI"
#ifndef MyAppVersion
  #define MyAppVersion "0.1.0"
#endif
#ifndef OutputDir
  #define OutputDir "D:\Tonevyra_install"
#endif
#ifndef InstallerSrc
  #define InstallerSrc "."
#endif

[Setup]
AppId={{5C2E9F1B-2A7D-4B6E-9E0C-1F3A6B2D48C9}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher=Tonevyra
AppPublisherURL=https://tonevyra.ai
DefaultDirName={localappdata}\Programs\TonevyraAI
DisableProgramGroupPage=yes
DisableDirPage=yes
; PostgreSQL unattended install, the Windows service and ProgramData receipts
; require elevation. Only OS elevation may interrupt the normal install flow.
; The app is intentionally installed into the elevating user's %LOCALAPPDATA%
; (per-user Agent per T-030/T-033). On the single-admin Tonevyra target the UAC
; consent keeps the same profile, so the per-user-areas warning is expected.
PrivilegesRequired=admin
UsedUserAreasWarning=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#OutputDir}
OutputBaseFilename=TonevyraAI-Setup-{#MyAppVersion}
Compression=lzma2/normal
SolidCompression=no
; The bundled model pushes the payload well past single-file limits.
DiskSpanning=yes
DiskSliceSize=2000000000
WizardStyle=modern
SetupLogging=yes
UninstallDisplayName={#MyAppName}
UninstallDisplayIcon={app}\TonevyraAI.exe
VersionInfoVersion={#MyAppVersion}
VersionInfoProductName={#MyAppName}
VersionInfoCompany=Tonevyra

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; 1. Main application: frozen TonevyraAI.exe + _internal runtime/DLLs/site-packages
Source: "{#AppSource}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion
; 2. App resources (branding / tray icons)
Source: "{#ResourcesSource}\*"; DestDir: "{app}\resources"; Flags: recursesubdirs createallsubdirs ignoreversion
; 2b. Default config template + install readme + product readme
Source: "{#InstallerSrc}\..\..\.env.example"; DestDir: "{app}"; DestName: ".env.example"; Flags: ignoreversion
Source: "{#InstallerSrc}\..\..\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#InstallerSrc}\README_INSTALL.txt"; DestDir: "{app}"; Flags: isreadme ignoreversion
; 2c. Mock vision fixture required by the post-install doctor's default backend
Source: "{#InstallerSrc}\..\..\harness\fixtures\vision\*"; DestDir: "{app}\harness\fixtures\vision"; Flags: recursesubdirs createallsubdirs ignoreversion
; 3. Local AI model weights/config/tokenizer (incompressible -> nocompression).
;    HuggingFace download bookkeeping is excluded.
Source: "{#ModelSource}\*"; DestDir: "{app}\models\qwen3-vl-4b-instruct"; Excludes: ".cache\*,*.metadata"; Flags: recursesubdirs createallsubdirs ignoreversion nocompression
; 3b. Relative-path model_manifest.json generated by the build script (wins over the source copy)
Source: "{#StageDir}\model_manifest.json"; DestDir: "{app}\models\qwen3-vl-4b-instruct"; Flags: ignoreversion
; 4. Lightroom plugin (bundled; provisioning helper links it into Lightroom when present)
Source: "{#PluginSource}\*"; DestDir: "{app}\lightroom\TonevyraAI.lrplugin"; Flags: recursesubdirs createallsubdirs ignoreversion
; 5. Provisioning + uninstall helper scripts
Source: "{#InstallerSrc}\Invoke-TonevyraProvision.ps1"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#InstallerSrc}\Remove-TonevyraDatabase.ps1"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\Tonevyra AI"; Filename: "{app}\TonevyraAI.exe"; Parameters: "tray"; WorkingDir: "{app}"; IconFilename: "{app}\TonevyraAI.exe"
Name: "{autodesktop}\Tonevyra AI"; Filename: "{app}\TonevyraAI.exe"; Parameters: "tray"; WorkingDir: "{app}"; IconFilename: "{app}\TonevyraAI.exe"

[UninstallDelete]
; Remove app-owned runtime scaffolding that Inno did not track. User config,
; PostgreSQL data and DB credentials are intentionally preserved by default.
Type: filesandordirs; Name: "{app}\runtime"
Type: filesandordirs; Name: "{app}\logs"

[Code]
var
  ProvisionOK: Boolean;
  ProvisionDetail: String;
  LightroomRestartRequired: Boolean;

{ Friendly Korean component names for the wizard status label (no Python /
  PostgreSQL / DB wizard is ever exposed to the user). }
procedure SetStage(const Caption: String);
begin
  WizardForm.StatusLabel.Caption := Caption;
  WizardForm.StatusLabel.Update;
end;

function ReadResultDetail(const ResultPath: String): String;
var
  Lines: TArrayOfString;
  I: Integer;
  Detail: String;
begin
  Detail := '';
  if FileExists(ResultPath) and LoadStringsFromFile(ResultPath, Lines) then
    for I := 0 to GetArrayLength(Lines) - 1 do
    begin
      if Detail <> '' then
        Detail := Detail + #13#10;
      Detail := Detail + Lines[I];
    end;
  Result := Detail;
end;

procedure RunProvisioning();
var
  PowerShellPath, ScriptPath, ResultPath, Params, Detail: String;
  ResultCode: Integer;
begin
  ProvisionOK := False;
  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  ScriptPath := ExpandConstant('{app}\Invoke-TonevyraProvision.ps1');
  ResultPath := ExpandConstant('{tmp}\tonevyra-provision-result.txt');
  DeleteFile(ResultPath);

  { Item 7: a visible PowerShell progress window is shown (SW_SHOWNORMAL) while
    the wizard status label tracks friendly component stages. }
  SetStage('로컬 데이터베이스 · 데이터베이스 초기화 · Lightroom 연동 · 백그라운드 에이전트 · 최종 검사를 진행합니다. 오래된 PC에서는 20~40분이 걸릴 수 있습니다.');
  Params := '-NoProfile -ExecutionPolicy Bypass -File "' + ScriptPath +
    '" -InstallRoot "' + ExpandConstant('{app}') +
    '" -ResultPath "' + ResultPath + '"';

  ResultCode := -1;
  if Exec(PowerShellPath, Params, ExpandConstant('{app}'), SW_SHOWNORMAL,
      ewWaitUntilTerminated, ResultCode) and (ResultCode = 0) then
  begin
    ProvisionOK := True;
    Detail := ReadResultDetail(ResultPath);
    LightroomRestartRequired := Pos('SUCCESS_RESTART_LIGHTROOM', Detail) > 0;
    exit;
  end;

  Detail := ReadResultDetail(ResultPath);
  if Detail = '' then
    Detail := Format('Provisioning process exit code: %d', [ResultCode]);
  ProvisionDetail := Detail;
  { Deliberately do NOT raise/abort here. Raising would let Setup roll back the
    already-installed app files, leaving a confusing "registered but missing
    files" state. Instead keep the files, do not launch the Agent
    (ShouldLaunch=False), warn the user with a retry command, and mark the
    Finished page as incomplete so success is never falsely reported. }
  MsgBox(
    'Tonevyra AI 데이터베이스 구성에 실패했습니다.' + #13#10 + #13#10 +
    Detail + #13#10 + #13#10 +
    '앱 파일은 설치되어 있습니다. 위 명령으로 재시도하거나 프로그램 추가/제거에서 제거할 수 있습니다.',
    mbError, MB_OK);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
    RunProvisioning();
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = wpFinished) and (not ProvisionOK) then
  begin
    WizardForm.FinishedHeadingLabel.Caption := 'Tonevyra AI 설치가 완료되지 않았습니다';
    WizardForm.FinishedLabel.Caption :=
      '앱 파일은 설치되었지만 데이터베이스 구성이 완료되지 않았습니다.' + #13#10 +
      '설치 로그: ' + ExpandConstant('{commonappdata}\TonevyraAI\install-receipts');
  end;
  if (CurPageID = wpFinished) and ProvisionOK and LightroomRestartRequired then
  begin
    WizardForm.FinishedHeadingLabel.Caption := 'Tonevyra AI 설치가 완료되었습니다';
    WizardForm.FinishedLabel.Caption :=
      '새 Lightroom 플러그인을 적용하려면 Lightroom Classic을 완전히 종료한 후 다시 실행하세요.';
  end;
end;

function ShouldLaunch(): Boolean;
begin
  { Only launch the Agent after the post-install doctor gate passed. }
  Result := ProvisionOK;
end;

[Run]
Filename: "{app}\TonevyraAI.exe"; Parameters: "tray"; WorkingDir: "{app}"; \
  Description: "Tonevyra AI 실행"; Flags: nowait postinstall skipifsilent; Check: ShouldLaunch

[UninstallRun]
; Uninstall preserves the database by default. Full DB/data removal is an
; explicit, separate flow via Remove-TonevyraDatabase.ps1 (not run here).
