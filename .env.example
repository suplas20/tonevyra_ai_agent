TONEVYRA_DATABASE_URL=postgresql+psycopg://tonevyra_app:<password>@localhost:5432/tonevyra_agent
TONEVYRA_DATABASE_SCHEMA=public
TONEVYRA_RUNTIME_DIR=runtime
TONEVYRA_INPUT_DIR=runtime/input
TONEVYRA_OUTPUT_DIR=runtime/output
TONEVYRA_ARTIFACT_DIR=runtime/artifacts
TONEVYRA_PREVIEW_DIR=runtime/previews
TONEVYRA_BRIDGE_DIR=runtime/bridge
TONEVYRA_LOG_DIR=logs
TONEVYRA_MODELS_DIR=models
TONEVYRA_VISION_BACKEND=qwen3vl
TONEVYRA_VISION_MOCK_FIXTURE=harness/fixtures/vision/valid_underwater.json
# Qwen2.5 is the technical stable candidate, not the commercial/default backend without license review.
TONEVYRA_QWEN_MODEL_PATH=models/qwen2.5-vl-3b-instruct-4bit
TONEVYRA_QWEN_MODEL_NAME=Qwen2.5-VL-3B-Instruct-4bit
TONEVYRA_QWEN_MODEL_REVISION=ebb281ec70b05090aa6165b016eac8ec08e71b17
TONEVYRA_QWEN_MODEL_SHA256=
# Qwen3 is the commercial/default candidate; promotion requires license review, benchmark evidence, rollback path, and human approval.
# Set TONEVYRA_EXTERNAL_MODELS_DIR when model files are stored outside the project directory.
TONEVYRA_EXTERNAL_MODELS_DIR=D:/Tonevyra/models
TONEVYRA_QWEN3_MODEL_PATH=D:/Tonevyra/models/Qwen3-VL-4B-Instruct
TONEVYRA_QWEN3_MODEL_NAME=Qwen3-VL-4B-Instruct
TONEVYRA_QWEN3_MODEL_REVISION=local-2025-06
TONEVYRA_QWEN3_MODEL_SHA256=
TONEVYRA_QWEN3_MANIFEST_PATH=models/qwen3-vl-4b-instruct/model_manifest.json
# T-022 model runtime settings
TONEVYRA_MODEL_MANIFEST_PATH=models/qwen3-vl-4b-instruct/model_manifest.json
TONEVYRA_MODEL_CONFIDENCE_THRESHOLD=0.6
TONEVYRA_QWEN_MAX_NEW_TOKENS=768
TONEVYRA_VISION_REVIEW_CONFIDENCE_THRESHOLD=0.7
TONEVYRA_PLANNER_REVIEW_CONFIDENCE_THRESHOLD=0.7
# Local test Planner Service. Production must use api mode with an approved HTTPS host.
TONEVYRA_PLANNER_API_MODE=local_server
TONEVYRA_PLANNER_API_BASE_URL=http://127.0.0.1:8000
TONEVYRA_PLANNER_API_KEY=secret-key
TONEVYRA_PLANNER_API_ALLOWED_HOST=127.0.0.1
# Correction Planner mode: legacy (rule mapping) | target_based (measurement-driven)
TONEVYRA_PLANNER_MODE=legacy
TONEVYRA_LIGHTROOM_BACKEND=lightroom
TONEVYRA_MODEL_OFFLINE=true
TONEVYRA_WORKER_CONCURRENCY=1
TONEVYRA_QUALITY_PASS_THRESHOLD=85
TONEVYRA_QUALITY_REVIEW_THRESHOLD=70
TONEVYRA_SUPPORTED_EXTENSIONS=.cr3,.cr2,.nef,.arw,.dng,.jpg,.jpeg
TONEVYRA_FILE_STABLE_CHECKS=3
TONEVYRA_FILE_STABLE_INTERVAL_SECONDS=1.0
TONEVYRA_FILE_STABLE_TIMEOUT_SECONDS=120.0
TONEVYRA_PREVIEW_LONG_EDGE=1024

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
HF_HUB_DISABLE_UPDATE_CHECK=1
