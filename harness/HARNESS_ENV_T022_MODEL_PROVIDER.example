TONEVYRA_PROJECT_ROOT=F:\tonevyra_ai_agent
TONEVYRA_MODEL_ROOT=F:\tonevyra_ai_agent\models
TONEVYRA_MODEL_ID=local-vision-model
TONEVYRA_MODEL_REVISION=pinned-revision
TONEVYRA_MODEL_CHECKSUM=replace-with-approved-sha256
TONEVYRA_MODEL_BACKEND=local_qwen_vision
TONEVYRA_MODEL_DEVICE=cuda
TONEVYRA_MODEL_DTYPE=float16
TONEVYRA_MODEL_QUANTIZATION=none
TONEVYRA_REMOTE_API_ENABLED=false
TONEVYRA_RUNTIME_DOWNLOAD_ENABLED=false
TONEVYRA_EXTERNAL_IMAGE_URL_ENABLED=false
TONEVYRA_ALLOW_MODULE_FALLBACK=false
TONEVYRA_MODEL_CONFIDENCE_THRESHOLD=0.70
TONEVYRA_MODEL_RUNTIME_MAX_RETRIES=1
