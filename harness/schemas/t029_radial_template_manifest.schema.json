{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonevyra.local/schemas/t029_radial_template_manifest.schema.json",
  "title": "Tonevyra T-029 Radial Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "library_version",
    "seed_signature",
    "generator_version",
    "supported_lightroom_min",
    "templates"
  ],
  "properties": {
    "schema_version": {"const": "t029.radial_template_manifest.v1"},
    "library_version": {"type": "string", "minLength": 1},
    "seed_signature": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "generator_version": {"type": "string", "minLength": 1},
    "supported_lightroom_min": {"type": "string", "minLength": 1},
    "supported_lightroom_max": {"type": ["string", "null"]},
    "fit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "minimum_coverage_ratio",
        "maximum_overflow_ratio",
        "maximum_center_distance",
        "minimum_fit_score"
      ],
      "properties": {
        "policy_version": {"type": "string", "minLength": 1},
        "minimum_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_overflow_ratio": {"type": "number", "minimum": 0},
        "maximum_center_distance": {"type": "number", "minimum": 0, "maximum": 1.414214},
        "maximum_aspect_log_error": {"type": "number", "minimum": 0},
        "minimum_fit_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/template"}
    }
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_space",
        "center_x",
        "center_y",
        "width",
        "height",
        "rotation_deg"
      ],
      "properties": {
        "coordinate_space": {"const": "oriented_normalized_image"},
        "center_x": {"type": "number", "minimum": 0, "maximum": 1},
        "center_y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rotation_deg": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "library_version",
        "relative_path",
        "sha256",
        "geometry",
        "feather",
        "size_class",
        "aspect_class",
        "supported_lightroom_min"
      ],
      "properties": {
        "template_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "library_version": {"type": "string", "minLength": 1},
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(^[A-Za-z]:|^/|\\.\\.)"}
        },
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "geometry": {"$ref": "#/$defs/geometry"},
        "feather": {"type": "number", "minimum": 0, "maximum": 1},
        "size_class": {"enum": ["small", "medium", "large"]},
        "aspect_class": {"enum": ["round", "horizontal", "vertical"]},
        "supported_lightroom_min": {"type": "string", "minLength": 1},
        "supported_lightroom_max": {"type": ["string", "null"]}
      }
    }
  }
}
