{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T-023 Semantic Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "attempt_id",
    "provider_type",
    "regions",
    "primary_region_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "t023.semantic.analysis.v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_type": {
      "enum": [
        "module",
        "model"
      ]
    },
    "primary_region_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region_id",
          "region_type",
          "priority",
          "confidence",
          "attributes",
          "quality_risks",
          "recommended_intents",
          "source"
        ],
        "properties": {
          "region_id": {
            "type": "string"
          },
          "region_type": {
            "enum": [
              "primary_subject",
              "secondary_subject",
              "person",
              "face",
              "skin",
              "hair",
              "sky",
              "background",
              "foreground",
              "product",
              "object"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "attributes": {
            "type": "object"
          },
          "quality_risks": {
            "type": "array"
          },
          "recommended_intents": {
            "type": "array"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
