{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonevyra.local/schemas/t030_windows_live_evidence.schema.json",
  "title": "T-030 Windows Live Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticket",
    "platform",
    "implementation_build",
    "tray_icon_asset_approved",
    "tray_visible",
    "single_instance_passed",
    "copy_in_progress_blocked",
    "deduplication_passed",
    "pause_resume_passed",
    "worker_crash_recovery_passed",
    "no_duplicate_external_effects",
    "graceful_shutdown_passed",
    "no_orphan_processes",
    "source_integrity_passed",
    "regressions_passed",
    "completed"
  ],
  "properties": {
    "schema_version": {"const": "t030.windows_live_evidence.v1"},
    "ticket": {"const": "T030"},
    "platform": {"const": "Windows"},
    "windows_build": {"type": "string"},
    "implementation_build": {"type": "string", "minLength": 1},
    "tray_icon_asset_approved": {"type": "boolean"},
    "tray_visible": {"type": "boolean"},
    "single_instance_passed": {"type": "boolean"},
    "copy_in_progress_blocked": {"type": "boolean"},
    "deduplication_passed": {"type": "boolean"},
    "pause_resume_passed": {"type": "boolean"},
    "worker_crash_recovery_passed": {"type": "boolean"},
    "no_duplicate_external_effects": {"type": "boolean"},
    "graceful_shutdown_passed": {"type": "boolean"},
    "no_orphan_processes": {"type": "boolean"},
    "source_integrity_passed": {"type": "boolean"},
    "regressions_passed": {"type": "boolean"},
    "screenshots": {"type": "array", "items": {"type": "string"}},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "completed": {"type": "boolean"}
  }
}
