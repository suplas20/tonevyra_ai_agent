{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T033 Windows Live Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "ticket",
    "platform",
    "architecture",
    "installer_signature_valid",
    "python_3119_bundled",
    "postgres_installer_downloaded",
    "postgres_installer_not_bundled",
    "postgres_service_ok",
    "database_ok",
    "agent_ok",
    "uninstall_data_preserved"
  ],
  "properties": {
    "schema_version": {
      "const": "t033.windows.live.v1"
    },
    "ticket": {
      "const": "T033"
    },
    "platform": {
      "const": "windows"
    },
    "architecture": {
      "const": "x64"
    }
  }
}
