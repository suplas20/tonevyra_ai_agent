{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t032_planner_error.schema.json",
  "title": "T032 Planner Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "request_id",
    "server_request_id",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "t032.planner.error.v1"
    },
    "status": {
      "const": "error"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "server_request_id": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "retry_after_seconds"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
