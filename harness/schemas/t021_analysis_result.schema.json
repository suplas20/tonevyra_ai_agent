{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t021.analysis.result.v1",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "attempt_id",
    "provider_type",
    "provider_version",
    "scene",
    "subjects",
    "technical_findings",
    "color_findings",
    "quality_risks",
    "confidence",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "t021.analysis.result.v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_type": {
      "enum": [
        "module",
        "model"
      ]
    },
    "provider_version": {
      "type": "string"
    },
    "scene": {
      "type": "object"
    },
    "subjects": {
      "type": "array"
    },
    "technical_findings": {
      "type": "array"
    },
    "color_findings": {
      "type": "array"
    },
    "quality_risks": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "lightroom_adjustments"
        ]
      },
      {
        "required": [
          "develop_settings"
        ]
      },
      {
        "required": [
          "preset_path"
        ]
      },
      {
        "required": [
          "final_decision"
        ]
      }
    ]
  },
  "additionalProperties": true
}
