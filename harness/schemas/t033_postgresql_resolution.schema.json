{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T033 PostgreSQL Stable Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "release_status",
    "version",
    "platform",
    "url",
    "sha256",
    "metadata_signature_verified",
    "installer_signature_required",
    "prerelease"
  ],
  "properties": {
    "schema_version": {
      "const": "t033.postgresql.resolution.v1"
    },
    "channel": {
      "const": "latest-stable"
    },
    "release_status": {
      "const": "stable"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "platform": {
      "enum": [
        "windows-x64",
        "macos-arm64"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata_signature_verified": {
      "const": true
    },
    "installer_signature_required": {
      "const": true
    },
    "prerelease": {
      "const": false
    }
  }
}
