{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonevyra.local/schemas/t029_live_evidence.schema.json",
  "title": "Tonevyra T-029 Real Lightroom Native-Mask Live Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "ticket",
    "phase0_passed",
    "lightroom_version",
    "plugin_version",
    "native_mask_command_supported",
    "native_target_detected",
    "mask_applied_without_ui_drawing",
    "target_alignment_passed",
    "background_spill_passed",
    "idempotent_replay_passed",
    "user_masks_preserved",
    "rollback_verified",
    "export_file_exists",
    "export_path",
    "quality_evidence_present",
    "regressions_passed",
    "evidence_paths"
  ],
  "properties": {
    "schema_version": {"const": "t029.live.evidence.v1"},
    "ticket": {"const": "T029"},
    "phase0_passed": {"type": "boolean"},
    "lightroom_version": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string", "minLength": 1},
    "native_mask_command_supported": {"type": "boolean"},
    "native_target_detected": {"type": "boolean"},
    "mask_applied_without_ui_drawing": {"type": "boolean"},
    "target_alignment_passed": {"type": "boolean"},
    "red_recovery_passed": {"type": "boolean"},
    "background_spill_passed": {"type": "boolean"},
    "idempotent_replay_passed": {"type": "boolean"},
    "user_masks_preserved": {"type": "boolean"},
    "rollback_verified": {"type": "boolean"},
    "export_file_exists": {"type": "boolean"},
    "export_path": {"type": "string", "minLength": 1},
    "quality_evidence_present": {"type": "boolean"},
    "regressions_passed": {"type": "boolean"},
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
