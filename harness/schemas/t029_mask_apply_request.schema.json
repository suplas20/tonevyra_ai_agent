{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonevyra.local/schemas/t029_mask_apply_request.schema.json",
  "title": "Tonevyra T-029 Lightroom Mask Apply Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "job_id",
    "attempt_id",
    "source_path",
    "command",
    "idempotency_key",
    "capability_snapshot_id",
    "mask_plan",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "t029.mask_apply.request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "command": {"const": "APPLY_LIGHTROOM_MASK_PLAN"},
    "idempotency_key": {"type": "string", "minLength": 8},
    "capability_snapshot_id": {"type": "string", "minLength": 1},
    "mask_plan": {"$ref": "#/$defs/maskPlan"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_space", "center_x", "center_y", "width", "height", "rotation_deg"],
      "properties": {
        "coordinate_space": {"const": "oriented_normalized_image"},
        "center_x": {"type": "number", "minimum": 0, "maximum": 1},
        "center_y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rotation_deg": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "nativeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted_types", "target_detected", "reason_code"],
      "properties": {
        "attempted_types": {
          "type": "array",
          "items": {"enum": ["subject", "people", "object", "sky", "background"]},
          "uniqueItems": true
        },
        "target_detected": {"type": "boolean"},
        "reason_code": {"type": "string", "minLength": 1}
      }
    },
    "localAdjustments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Exposure2012": {"type": "number", "minimum": -1, "maximum": 1},
        "Shadows2012": {"type": "number", "minimum": -40, "maximum": 40},
        "Temperature": {"type": "number", "minimum": -20, "maximum": 20},
        "Tint": {"type": "number", "minimum": -20, "maximum": 20},
        "Saturation": {"type": "number", "minimum": -35, "maximum": 35},
        "Vibrance": {"type": "number", "minimum": -30, "maximum": 30},
        "Texture": {"type": "number", "minimum": -20, "maximum": 20},
        "Clarity2012": {"type": "number", "minimum": -20, "maximum": 20},
        "Dehaze": {"type": "number", "minimum": -15, "maximum": 15}
      },
      "minProperties": 1
    },
    "pointColor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source_hue", "source_saturation", "source_luminance", "hue_shift", "saturation_shift", "luminance_shift"],
      "properties": {
        "source_hue": {"type": "number", "minimum": 0, "maximum": 360},
        "source_saturation": {"type": "number", "minimum": 0, "maximum": 1},
        "source_luminance": {"type": "number", "minimum": 0, "maximum": 1},
        "hue_shift": {"type": "number", "minimum": -60, "maximum": 60},
        "saturation_shift": {"type": "number", "minimum": -0.5, "maximum": 0.5},
        "luminance_shift": {"type": "number", "minimum": -0.3, "maximum": 0.3}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_user_masks", "non_destructive_required", "max_background_spill"],
      "properties": {
        "preserve_user_masks": {"const": true},
        "non_destructive_required": {"const": true},
        "max_background_spill": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target_region_id",
        "strategy",
        "native_assessment",
        "predicted_geometry",
        "mask_name",
        "local_adjustments",
        "safety"
      ],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "target_region_id": {"type": "string", "minLength": 1},
        "strategy": {"enum": ["native_ai", "skip_local", "review_required"]},
        "native_assessment": {"$ref": "#/$defs/nativeAssessment"},
        "predicted_geometry": {"$ref": "#/$defs/geometry"},
        "mask_name": {"type": "string", "pattern": "^Tonevyra::T029::"},
        "local_adjustments": {"$ref": "#/$defs/localAdjustments"},
        "point_color": {"$ref": "#/$defs/pointColor"},
        "safety": {"$ref": "#/$defs/safety"}
      }
    },
    "maskPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "planner_version", "operations"],
      "properties": {
        "schema_version": {"const": "t029.mask_plan.v1"},
        "plan_id": {"type": "string", "minLength": 1},
        "planner_version": {"type": "string", "minLength": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    }
  }
}
