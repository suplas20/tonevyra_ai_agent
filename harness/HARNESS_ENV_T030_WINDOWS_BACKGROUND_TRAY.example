# T-030 Windows background/tray harness configuration
TONEVYRA_T030_WATCH_PATH=runtime/harness/t030/input
TONEVYRA_T030_OUTPUT_PATH=runtime/harness/t030/output
TONEVYRA_T030_RECURSIVE=false
TONEVYRA_T030_STABILITY_INTERVAL_SECONDS=2
TONEVYRA_T030_REQUIRED_STABLE_SAMPLES=3
TONEVYRA_T030_STABILITY_TIMEOUT_SECONDS=300
TONEVYRA_T030_HEARTBEAT_TIMEOUT_SECONDS=20
TONEVYRA_T030_MAX_RESTARTS=3
TONEVYRA_T030_AUTOSTART=false
TONEVYRA_T030_TRAY_ENABLED=true
TONEVYRA_T030_STRICT_WINDOWS_LIVE=false
