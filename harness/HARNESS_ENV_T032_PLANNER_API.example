# Local client
TONEVYRA_PLANNER_BASE_URL=https://planner.example.invalid
TONEVYRA_PLANNER_API_KEY=<load-from-secure-store-not-source>
TONEVYRA_PLANNER_CONNECT_TIMEOUT_SECONDS=3
TONEVYRA_PLANNER_READ_TIMEOUT_SECONDS=12
TONEVYRA_PLANNER_TOTAL_ATTEMPTS=3
TONEVYRA_PLANNER_MAX_RETRY_AFTER_SECONDS=30
TONEVYRA_PLANNER_REQUEST_MAX_BYTES=262144
TONEVYRA_PLANNER_ALLOWED_HOSTS=planner.example.invalid
TONEVYRA_PLANNER_ALLOW_LOCAL_FALLBACK=false

# Server
TONEVYRA_PLANNER_BIND_HOST=127.0.0.1
TONEVYRA_PLANNER_BIND_PORT=8000
TONEVYRA_PLANNER_WORKERS=1
TONEVYRA_PLANNER_EXECUTION_CONCURRENCY=1
TONEVYRA_PLANNER_API_KEY_HASHES=<secret-reference>
TONEVYRA_PLANNER_IDEMPOTENCY_BACKEND=<durable-backend-url>
TONEVYRA_PLANNER_IDEMPOTENCY_RETENTION_SECONDS=86400
TONEVYRA_PLANNER_LOG_PAYLOADS=false
TONEVYRA_PLANNER_ENABLE_DOCS=false
TONEVYRA_PLANNER_POLICY_VERSION=2026-07-07.1
TONEVYRA_T032_EVIDENCE_DIR=runtime/evidence/t032
